---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TickerTape from '../components/TickerTape.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  schema?: object | object[];
}

const {
  title = 'TradingWissen.ch — Trading Wissen für die Schweiz',
  description = 'Unabhängige Trading-Information, Broker-Vergleiche und Strategien für Schweizer Trader. Verständlich, ehrlich, praxisnah.',
  image = '/og-default.png',
  type = 'website',
  schema,
} = Astro.props;

// Sitewide-Schemas: Organization + WebSite (mit SearchAction für Google Sitelinks-Suche)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://www.tradingwissen.ch/#organization",
  "name": "TradingWissen.ch",
  "url": "https://www.tradingwissen.ch/",
  "logo": "https://www.tradingwissen.ch/og-default.png",
  "description": "Unabhängige Trading-Information, Broker-Vergleiche und Strategien für Schweizer Trader.",
  "email": "info@tradingwissen.ch",
  "areaServed": "CH",
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://www.tradingwissen.ch/#website",
  "name": "TradingWissen.ch",
  "url": "https://www.tradingwissen.ch/",
  "publisher": { "@id": "https://www.tradingwissen.ch/#organization" },
  "inLanguage": "de-CH",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": "https://www.tradingwissen.ch/suche/?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};

const schemas = [
  organizationSchema,
  websiteSchema,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="de_CH" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="TradingWissen.ch" href="/rss.xml" />

    <!-- Vercel Speed Insights (im Vercel-Dashboard unter "Speed Insights" aktivieren) -->
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>

    <!-- Google Analytics 4 — lädt erst nach Cookie-Einwilligung (CookieBanner) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.loadGA = function () {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-03B1NV6MHH';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-03B1NV6MHH', { 'anonymize_ip': true });
      };
      if (localStorage.getItem('cookie-consent') === 'accepted') window.loadGA();
    </script>
    {schemas.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- GA4 Event-Tracking: Newsletter, Affiliate/Outbound, Werbung -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        if (typeof gtag !== 'function') return;
        var el = e.target.closest('a, button, form button[type="submit"]');
        if (!el) return;

        // Newsletter-Klicks (Links zu /newsletter, Beehiiv oder Signup-Formulare)
        var href = el.getAttribute('href') || '';
        if (href.includes('/newsletter') || href.includes('beehiiv.com') || el.closest('[data-track="newsletter"]')) {
          gtag('event', 'newsletter_click', { link_url: href || 'signup_form', page: location.pathname });
          return;
        }
        // Werbeplätze (Mock-Platzhalter und echte Sponsor-Anzeigen)
        var adEl = el.closest('.ad-slot, .ad-placeholder');
        if (adEl) {
          gtag('event', 'ad_click', {
            page: location.pathname,
            sponsor: adEl.getAttribute('data-sponsor') || 'placeholder'
          });
          return;
        }
        // Ausgehende Links (potenzielle Affiliate-Links)
        if (el.tagName === 'A' && href.startsWith('http') && !href.includes(location.hostname)) {
          var domain = '';
          try { domain = new URL(href).hostname; } catch {}
          gtag('event', 'outbound_click', { link_url: href, link_domain: domain, page: location.pathname });
        }
      }, { passive: true });
    </script>
  </head>
  <body>
    <Header />
    <TickerTape />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
