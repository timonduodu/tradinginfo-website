---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TickerTape from '../components/TickerTape.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'TradingInfo.ch — Trading Wissen für die Schweiz',
  description = 'Unabhängige Trading-Information, Broker-Vergleiche und Strategien für Schweizer Trader. Verständlich, ehrlich, praxisnah.',
  image = '/og-default.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content="de_CH" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="TradingInfo.ch" href="/rss.xml" />

    <!--
      GOOGLE SEARCH CONSOLE
      Verifiziert für tradinginfo.beehiiv.com und kommende Domain tradinginfo.ch
    -->
    <meta name="google-site-verification" content="lBYKhkm3C7HJGBi1ts7ZaiVuFxBZ6NvxoIdEJWnoNqg" />

    <!--
      GOOGLE ANALYTICS 4
      ==================
      1. Gehe zu analytics.google.com
      2. Neue Property erstellen für tradinginfo.ch
      3. Bei "Datenstream" → Web → URL eingeben → Stream erstellen
      4. Die Measurement-ID kopieren (Format: G-XXXXXXXXXX)
      5. Unten "G-DEINE_ID" durch deine ID ersetzen (an beiden Stellen!)
    -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DEINE_ID"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DEINE_ID', {
        'anonymize_ip': true
      });
    </script>
  </head>
  <body>
    <Header />
    <TickerTape />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
