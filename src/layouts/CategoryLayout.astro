---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

interface Props {
  category: 'Grundlagen' | 'Broker' | 'Strategien' | 'Steuern' | 'News';
  title: string;
  description: string;
  intro: string;
  subcategories?: { slug: string; label: string }[];
}

const { category, title, description, intro, subcategories } = Astro.props;

const now = new Date();
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.category === category)
  .filter(p => p.data.pubDate <= now)  // Scheduled Posts ausblenden
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Subkategorien automatisch aus den Posts extrahieren
const detectedSubcats = subcategories || Array.from(
  new Set(posts.map(p => p.data.subcategory).filter(Boolean))
).map(s => ({ slug: s as string, label: s as string }));
---

<BaseLayout title={`${title} — TradingWissen.ch`} description={description}>
  <section class="category-hero container-narrow">
    <span class="eyebrow">Kategorie</span>
    <h1>{title}</h1>
    <p class="intro">{intro}</p>
  </section>

  {detectedSubcats.length > 0 && (
    <nav class="subcat-nav container">
      <button class="subcat-link subcat-active" data-filter="all">Alle Artikel</button>
      {detectedSubcats.map(sc => (
        <button class="subcat-link" data-filter={sc.slug}>{sc.label}</button>
      ))}
    </nav>
  )}

  <div class="container">
    <AdSlot type="banner" slot="top" />
  </div>

  <section class="container article-list">
    {posts.length > 0 ? (
      <div class="posts" id="posts-container">
        {posts.map(post => (
          <article class="post-item" data-subcat={post.data.subcategory || ''}>
            <a href={`/blog/${post.slug}`} class="post-link">
              <div class="post-content">
                <span class="category-tag">{post.data.subcategory || post.data.category}</span>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span>·</span>
                      <span>{post.data.readingTime}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty">
        <p>In dieser Kategorie sind noch keine Artikel verfügbar.</p>
        <p>Der erste Beitrag erscheint in Kürze. <a href="/newsletter">Newsletter abonnieren</a>, um benachrichtigt zu werden.</p>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // Subkategorien-Filter (Client-side)
  const buttons = document.querySelectorAll<HTMLButtonElement>('.subcat-link');
  const posts = document.querySelectorAll<HTMLElement>('.post-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach(b => b.classList.remove('subcat-active'));
      btn.classList.add('subcat-active');

      posts.forEach(p => {
        if (filter === 'all' || p.dataset.subcat === filter) {
          p.style.display = '';
        } else {
          p.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .category-hero {
    padding: var(--space-2xl) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .category-hero h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .intro {
    font-size: 1.2rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto;
  }

  .subcat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 var(--space-md) var(--space-md);
    justify-content: center;
  }

  .subcat-link {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    padding: 0.45rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .subcat-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .subcat-link.subcat-active {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }

  .article-list {
    padding: var(--space-lg) var(--space-md) var(--space-2xl);
  }

  .posts {
    max-width: 860px;
    margin: 0 auto;
  }

  .post-item {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-lg) 0;
  }

  .post-item:first-child {
    border-top: 1px solid var(--color-rule);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: opacity 0.2s;
  }

  .post-link:hover {
    opacity: 0.75;
  }

  .post-title {
    font-size: 1.75rem;
    margin: var(--space-sm) 0;
    line-height: 1.2;
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .post-meta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    display: flex;
    gap: var(--space-xs);
  }

  .empty {
    text-align: center;
    padding: var(--space-2xl) var(--space-md);
    max-width: 500px;
    margin: 0 auto;
    color: var(--color-ink-soft);
  }

  .empty p {
    margin-bottom: var(--space-sm);
  }
</style>
