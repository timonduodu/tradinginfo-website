---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  // Nur veröffentlichte Artikel (pubDate <= heute) bekommen eine Seite
  const posts = (await getCollection('blog'))
    .filter(post => post.data.pubDate <= now);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const now = new Date();
const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category && p.data.pubDate <= now)
  .slice(0, 3);
---

<BaseLayout title={`${post.data.title} — TradingWissen.ch`} description={post.data.description}>
  <article class="post">
    <header class="post-header container-narrow">
      <a href={`/${post.data.category.toLowerCase()}`} class="category-tag">{post.data.category}</a>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <span>Von <strong>{post.data.author}</strong></span>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {post.data.readingTime && (
          <>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
      </div>
    </header>

    <!-- Article Hero Image -->
    <div class="container-narrow">
      <ArticleHero slug={post.slug} category={post.data.category} alt={post.data.title} />
    </div>

    <!-- In-article ad slot (top) -->
    <div class="container-narrow">
      <AdSlot type="inline" slot="middle" />
    </div>

    <div class="post-content container-narrow">
      <Content />
    </div>

    <!-- In-article ad slot (bottom) -->
    <div class="container-narrow">
      <AdSlot type="inline" slot="bottom" />
    </div>

    <!-- Affiliate disclosure -->
    <div class="container-narrow">
      <aside class="affiliate-note">
        <strong>Transparenz-Hinweis:</strong> Dieser Artikel kann Affiliate-Links enthalten.
        Wenn du über einen solchen Link einen Account eröffnest, erhält TradingWissen.ch eine
        kleine Provision — ohne Mehrkosten für dich. Das hilft uns, diese Seite unabhängig
        und ohne Paywall zu betreiben.
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related container">
        <div class="section-header">
          <h2 class="section-title">Weiterlesen</h2>
          <span class="section-rule"></span>
        </div>
        <div class="related-grid">
          {related.map(p => (
            <a href={`/blog/${p.slug}`} class="related-card">
              <span class="category-tag">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-xl);
  }

  .post-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: var(--space-sm) 0 var(--space-md);
    line-height: 1.1;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .post-meta {
    display: flex;
    gap: var(--space-xs);
    justify-content: center;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    padding-bottom: var(--space-md);
    border-bottom: 3px double var(--color-rule);
  }

  .post-content {
    padding: var(--space-lg) var(--space-md);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .post-content :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-rule);
  }

  .post-content :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(p) {
    margin-bottom: 1.5em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: var(--space-md) 0 var(--space-md) var(--space-md);
  }

  .post-content :global(li) {
    margin-bottom: 0.5em;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--space-md) 0;
    border-radius: 2px;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--color-bg-alt);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-content :global(blockquote) {
    margin: var(--space-lg) 0;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-accent);
    font-family: var(--font-serif);
    position: relative;
  }

  .post-content :global(blockquote)::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-size: 4rem;
    color: var(--color-accent);
    opacity: 0.2;
    font-family: var(--font-serif);
    line-height: 1;
  }

  .post-content :global(blockquote p) {
    font-size: 1.25rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--color-ink);
    margin-bottom: 0.5em;
  }

  .post-content :global(blockquote p:last-child) {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-style: normal;
    color: var(--color-ink-soft);
    margin-bottom: 0;
  }

  .affiliate-note {
    margin: var(--space-md);
    padding: var(--space-md);
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .affiliate-note strong {
    color: var(--color-ink);
  }

  .related {
    padding: var(--space-xl) var(--space-md);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-ink);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .related-card {
    padding: var(--space-md);
    border: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .related-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .related-card h3 {
    font-size: 1.2rem;
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .related-card p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin: 0;
  }

  @media (max-width: 768px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
