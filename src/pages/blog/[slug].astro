---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import AdSlot from '../../components/AdSlot.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  // Nur veröffentlichte Artikel (pubDate <= heute) bekommen eine Seite
  const posts = (await getCollection('blog'))
    .filter(post => post.data.pubDate <= now);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const toc = headings.filter(h => h.depth === 2);

const now = new Date();
const allPosts = await getCollection('blog');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category && p.data.pubDate <= now)
  .slice(0, 3);

const ogImage = `/og/${post.slug}.png`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": `https://www.tradingwissen.ch${ogImage}`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": { "@type": "Organization", "name": post.data.author },
  "publisher": {
    "@type": "Organization",
    "name": "TradingWissen",
    "logo": { "@type": "ImageObject", "url": "https://tradingwissen.ch/og-default.png" }
  },
  "mainEntityOfPage": `https://tradingwissen.ch/blog/${post.slug}/`
};

// Breadcrumbs: Start → Kategorie → Artikel
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.tradingwissen.ch/" },
    { "@type": "ListItem", "position": 2, "name": post.data.category, "item": `https://www.tradingwissen.ch/${post.data.category.toLowerCase()}/` },
    { "@type": "ListItem", "position": 3, "name": post.data.title },
  ],
};

// FAQ-Schema: aus Frontmatter (faq:) oder automatisch aus Frage-Überschriften
// (H2/H3, die mit "?" enden) + dem darauffolgenden Absatz extrahiert.
function stripMarkdown(text: string): string {
  return text
    .replace(/```[\s\S]*?```/g, '')          // Codeblöcke
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // Links → Linktext
    .replace(/[*_`#>]/g, '')                 // Formatierungszeichen
    .replace(/\|[^\n]*\|/g, '')              // Tabellenzeilen
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaq(body: string): { question: string; answer: string }[] {
  const faqs: { question: string; answer: string }[] = [];
  const regex = /^#{2,3} +(.+\?)\s*\n+([\s\S]*?)(?=\n#{1,6} |\s*$)/gm;
  let match;
  while ((match = regex.exec(body)) !== null) {
    const question = stripMarkdown(match[1]);
    let answer = stripMarkdown(match[2]);
    if (answer.length > 400) {
      // An Satzgrenze kürzen
      const cut = answer.slice(0, 400);
      answer = cut.slice(0, Math.max(cut.lastIndexOf('. '), 200) + 1);
    }
    if (question && answer.length >= 40) faqs.push({ question, answer });
  }
  return faqs;
}

const faqs = post.data.faq?.length ? post.data.faq : extractFaq(post.body);
const faqSchema = faqs.length >= 2 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
} : null;

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={`${post.data.title} — TradingWissen.ch`} description={post.data.description} image={ogImage} type="article" schema={schemas}>
  <div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar" id="reading-progress-bar"></div></div>
  <article class="post" data-pagefind-body>
    <nav class="breadcrumbs container-narrow" aria-label="Breadcrumb" data-pagefind-ignore>
      <ol>
        <li><a href="/">Start</a></li>
        <li><a href={`/${post.data.category.toLowerCase()}`}>{post.data.category}</a></li>
        <li aria-current="page">{post.data.title}</li>
      </ol>
    </nav>
    <header class="post-header container-narrow">
      <a href={`/${post.data.category.toLowerCase()}`} class="category-tag" data-pagefind-filter="Kategorie">{post.data.category}</a>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <div class="post-meta">
        <span>Von <a href="/about" class="author-link"><strong>{post.data.author}</strong></a></span>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {post.data.readingTime && (
          <>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </>
        )}
        {post.data.updatedDate && (
          <>
            <span>·</span>
            <span class="updated">Aktualisiert: {post.data.updatedDate.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </>
        )}
      </div>
    </header>

    <!-- Article Hero Image -->
    <div class="container-narrow">
      <ArticleHero slug={post.slug} category={post.data.category} alt={post.data.title} />
    </div>

    <!-- In-article ad slot (top) -->
    <div class="container-narrow">
      <AdSlot type="inline" slot="middle" />
    </div>

    {toc.length >= 4 && (
      <nav class="toc container-narrow" aria-label="Inhaltsverzeichnis">
        <div class="toc-inner">
          <p class="toc-title">Auf dieser Seite</p>
          <ol>
            {toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </div>
      </nav>
    )}

    <div class="post-content container-narrow">
      <Content />
    </div>

    <!-- Share buttons -->
    <div class="container-narrow share-wrap">
      <ShareButtons title={post.data.title} url={`https://www.tradingwissen.ch/blog/${post.slug}/`} />
    </div>

    <!-- Newsletter signup -->
    <div class="container-narrow">
      <NewsletterSignup />
    </div>

    <!-- In-article ad slot (bottom) -->
    <div class="container-narrow">
      <AdSlot type="inline" slot="bottom" />
    </div>

    <!-- Affiliate disclosure -->
    <div class="container-narrow">
      <aside class="affiliate-note">
        <strong>Transparenz-Hinweis:</strong> Dieser Artikel kann Affiliate-Links enthalten.
        Wenn du über einen solchen Link einen Account eröffnest, erhält TradingWissen.ch eine
        kleine Provision, ohne Mehrkosten für dich. Das hilft uns, diese Seite unabhängig
        und ohne Paywall zu betreiben.
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related container">
        <div class="section-header">
          <h2 class="section-title">Weiterlesen</h2>
          <span class="section-rule"></span>
        </div>
        <div class="related-grid">
          {related.map(p => (
            <a href={`/blog/${p.slug}`} class="related-card">
              <span class="category-tag">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Glossar-Tooltips: Fachbegriffe im Artikeltext bekommen eine Hover-Erklärung
  // und verlinken auf den Glossar-Eintrag. Lädt verzögert, blockiert nichts.
  async function initGlossarTooltips() {
    const content = document.querySelector('.post-content');
    if (!content) return;
    let glossar: { b: string; d: string; a: string }[];
    try {
      glossar = await (await fetch('/glossar.json')).json();
    } catch { return; }

    // Längste Begriffe zuerst, damit "Bid-Ask-Spread" vor "Spread" matcht
    glossar.sort((x, y) => y.b.length - x.b.length);
    const used = new Set<string>();
    const MAX_TOOLTIPS = 12;
    let count = 0;

    const SKIP = new Set(['A', 'CODE', 'PRE', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'BUTTON', 'SCRIPT', 'STYLE']);
    const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        for (let el = node.parentElement; el && el !== content; el = el.parentElement) {
          if (SKIP.has(el.tagName) || el.classList.contains('glossar-hint')) return NodeFilter.FILTER_REJECT;
        }
        return NodeFilter.FILTER_ACCEPT;
      },
    });

    const textNodes: Text[] = [];
    let n;
    while ((n = walker.nextNode())) textNodes.push(n as Text);

    for (const textNode of textNodes) {
      if (count >= MAX_TOOLTIPS) break;
      for (const eintrag of glossar) {
        if (count >= MAX_TOOLTIPS) break;
        if (used.has(eintrag.a)) continue;
        const text = textNode.textContent || '';
        const escaped = eintrag.b.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const match = new RegExp(`(?<![\\wäöüÄÖÜß-])(${escaped})(?![\\wäöüÄÖÜß-])`, 'i').exec(text);
        if (!match || match.index === undefined) continue;

        const link = document.createElement('a');
        link.className = 'glossar-hint';
        link.href = `/glossar#${eintrag.a}`;
        link.textContent = match[1];
        link.setAttribute('data-def', eintrag.d);

        const after = textNode.splitText(match.index);
        after.textContent = (after.textContent || '').slice(match[1].length);
        textNode.parentNode!.insertBefore(link, after);
        used.add(eintrag.a);
        count++;
        break; // pro Textknoten max. 1 Tooltip, dann weiter
      }
    }
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => initGlossarTooltips());
  } else {
    setTimeout(initGlossarTooltips, 1500);
  }
</script>

<script>
  // Lesefortschrittsbalken
  const bar = document.getElementById('reading-progress-bar');
  const content = document.querySelector('.post-content');
  if (bar && content) {
    const update = () => {
      const rect = (content as HTMLElement).getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
      bar.style.transform = `scaleX(${progress})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 100;
    background: transparent;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .breadcrumbs {
    margin-bottom: var(--space-md);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '›';
    margin-left: 0.4rem;
    color: var(--color-ink-muted);
  }

  .breadcrumbs a {
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .breadcrumbs li[aria-current] {
    color: var(--color-ink-muted);
    max-width: 28ch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .share-wrap {
    margin: var(--space-lg) auto;
  }

  .author-link {
    color: inherit;
    text-decoration: none;
  }
  .author-link:hover {
    color: var(--color-accent);
  }

  /* Glossar-Tooltips */
  .post-content :global(.glossar-hint) {
    color: inherit;
    text-decoration: underline dotted var(--color-ink-muted) 1.5px;
    text-underline-offset: 3px;
    position: relative;
    cursor: help;
  }

  .post-content :global(.glossar-hint:hover),
  .post-content :global(.glossar-hint:focus) {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .post-content :global(.glossar-hint::after) {
    content: attr(data-def);
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: min(320px, 80vw);
    padding: 0.7rem 0.9rem;
    background: var(--color-band-bg);
    color: var(--color-band-ink);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s;
    pointer-events: none;
    z-index: 50;
  }

  .post-content :global(.glossar-hint:hover::after),
  .post-content :global(.glossar-hint:focus::after) {
    opacity: 1;
    visibility: visible;
  }

  .updated {
    font-style: italic;
    color: var(--color-ink-soft);
  }
  .toc {
    margin: var(--space-lg) auto;
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--color-accent);
    background: var(--color-tint);
  }
  .toc-title {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0 0 var(--space-sm);
    font-weight: 700;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.2rem;
  }
  .toc li {
    margin: 0.3rem 0;
    font-size: 0.95rem;
  }
  .toc a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Ab 1380px: TOC als Seitenleiste rechts neben dem Artikel.
     position: sticky statt fixed — startet in der Flussposition (unterhalb
     des Headers, neben dem Artikelanfang) und klebt erst beim Scrollen
     oben am Viewport. Ragt so nie in den Header hinein. */
  @media (min-width: 1380px) {
    .toc {
      position: sticky;
      top: 24px;
      height: 0; /* keine Flusshöhe — schiebt den Artikel nicht nach unten */
      overflow: visible;
      margin: 0 auto;
      padding: 0;
      border: none;
      background: none;
      z-index: 10;
    }
    .toc-inner {
      position: absolute;
      top: 0;
      left: calc(100% + 32px);
      width: 280px;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      padding: var(--space-md) var(--space-lg);
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-left: 3px solid var(--color-accent);
    }
    .toc li { font-size: 0.85rem; }
  }
  .post {
    padding-top: var(--space-xl);
  }

  .post-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: var(--space-sm) 0 var(--space-md);
    line-height: 1.1;
  }

  .post-description {
    font-size: 1.25rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .post-meta {
    display: flex;
    gap: var(--space-xs);
    justify-content: center;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-ink-muted);
    padding-bottom: var(--space-md);
    border-bottom: 3px double var(--color-rule);
  }

  .post-content {
    padding: var(--space-lg) var(--space-md);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .post-content :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-rule);
  }

  .post-content :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .post-content :global(p) {
    margin-bottom: 1.5em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: var(--space-md) 0 var(--space-md) var(--space-md);
  }

  .post-content :global(li) {
    margin-bottom: 0.5em;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: var(--space-md) 0;
    border-radius: 2px;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-md) 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--color-bg-alt);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-content :global(blockquote) {
    margin: var(--space-lg) 0;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-accent);
    font-family: var(--font-serif);
    position: relative;
  }

  .post-content :global(blockquote)::before {
    content: '"';
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    font-size: 4rem;
    color: var(--color-accent);
    opacity: 0.2;
    font-family: var(--font-serif);
    line-height: 1;
  }

  .post-content :global(blockquote p) {
    font-size: 1.25rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--color-ink);
    margin-bottom: 0.5em;
  }

  .post-content :global(blockquote p:last-child) {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-style: normal;
    color: var(--color-ink-soft);
    margin-bottom: 0;
  }

  .affiliate-note {
    margin: var(--space-md);
    padding: var(--space-md);
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .affiliate-note strong {
    color: var(--color-ink);
  }

  .related {
    padding: var(--space-xl) var(--space-md);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .section-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-ink);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .related-card {
    padding: var(--space-md);
    border: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }

  .related-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .related-card h3 {
    font-size: 1.2rem;
    margin: var(--space-sm) 0 var(--space-xs);
  }

  .related-card p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    margin: 0;
  }

  @media (max-width: 768px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
