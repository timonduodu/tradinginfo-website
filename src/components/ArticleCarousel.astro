---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title: string;
}

const { posts, title } = Astro.props;
---

<section class="carousel-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
      <span class="section-rule"></span>
      <div class="carousel-nav">
        <button class="carousel-btn" id="carousel-prev" aria-label="Zurück">←</button>
        <button class="carousel-btn" id="carousel-next" aria-label="Weiter">→</button>
      </div>
    </div>

    <div class="carousel-wrapper">
      <div class="carousel-track" id="carousel-track">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="carousel-card">
            <div class="card-image">
              <img
                src={`https://source.unsplash.com/600x400/?finance,${post.data.category.toLowerCase()},markets&sig=${post.slug}`}
                alt={post.data.title}
                loading="lazy"
              />
            </div>
            <div class="card-content">
              <span class="category-tag">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('de-CH', { day: 'numeric', month: 'short', year: 'numeric' })}
              </time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');

  if (track && prevBtn && nextBtn) {
    const scrollAmount = () => {
      const card = track.querySelector('.carousel-card') as HTMLElement;
      return card ? card.offsetWidth + 24 : 300;
    };

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });
  }
</script>

<style>
  .carousel-section {
    padding: var(--space-xl) 0;
    background: var(--color-paper);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding: 0 var(--space-md);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    margin: 0;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-ink);
  }

  .carousel-nav {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .carousel-btn {
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.2s;
    border-radius: 2px;
  }

  .carousel-btn:hover {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
  }

  .carousel-wrapper {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 var(--space-md);
    scroll-padding: var(--space-md);
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-card {
    flex: 0 0 320px;
    scroll-snap-align: start;
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-rule);
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .carousel-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(10, 37, 64, 0.08);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    padding: var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h3 {
    font-size: 1.2rem;
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.3;
    transition: color 0.2s;
  }

  .carousel-card:hover h3 {
    color: var(--color-accent);
  }

  .card-content p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-bottom: var(--space-sm);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-content time {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 640px) {
    .carousel-card {
      flex: 0 0 280px;
    }
  }
</style>
