---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title: string;
}

const { posts, title } = Astro.props;

// Kuratierte Unsplash-Bilder pro Kategorie (gleiche IDs wie ArticleHero)
const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    'photo-1611974789855-9c2a0a7236a3',
    'photo-1590283603385-17ffb3a7f29f',
    'photo-1554260570-9140fd3b7614',
    'photo-1635236066449-5077fffbe50f',
    'photo-1518186285589-2f7649de83e0',
  ],
  'Strategien': [
    'photo-1642543492481-44e81e3914a7',
    'photo-1551836022-d5d88e9218df',
    'photo-1543286386-2e659306cd6c',
    'photo-1591696205602-2f950c417cb9',
  ],
  'Broker': [
    'photo-1604594849809-dfedbc827105',
    'photo-1450101499163-c8848c66ca85',
    'photo-1495216875107-c6c043eb703f',
    'photo-1577962917302-cd874c4e31d2',
  ],
  'Steuern': [
    'photo-1554224155-6726b3ff858f',
    'photo-1554224154-26032cfc77ff',
    'photo-1554224154-22dec7ec8818',
    'photo-1518568814500-bf0f8d125f46',
  ],
};

function getImageForPost(post: CollectionEntry<'blog'>): string {
  const images = categoryImages[post.data.category] || categoryImages['Grundlagen'];
  const hash = post.slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  return images[hash % images.length];
}

// Duplizieren für nahtloses Looping
const loopPosts = [...posts, ...posts];
---

<section class="carousel-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
      <span class="section-rule"></span>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-track" id="auto-carousel-track">
      {loopPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="carousel-card">
          <div class="card-image">
            <img
              src={`https://images.unsplash.com/${getImageForPost(post)}?w=600&h=400&fit=crop&q=80`}
              alt={post.data.title}
              loading="lazy"
            />
          </div>
          <div class="card-content">
            <span class="category-tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // Auto-scroll: kontinuierlich langsam nach rechts
  const track = document.getElementById('auto-carousel-track');
  if (track) {
    let paused = false;

    // Pause bei Hover
    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; });

    // Auto-Scroll Loop
    function autoScroll() {
      if (!paused && track) {
        track.scrollLeft += 1;
        // Wenn am Ende, springe zurück zur Mitte (nahtlos)
        if (track.scrollLeft >= track.scrollWidth / 2) {
          track.scrollLeft = 0;
        }
      }
      requestAnimationFrame(autoScroll);
    }
    autoScroll();
  }
</script>

<style>
  .carousel-section {
    padding: var(--space-md) 0 var(--space-xl);
    background: var(--color-paper);
    margin: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding: 0 var(--space-md);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    margin: 0;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-ink);
  }

  .carousel-wrapper {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: var(--space-md);
    overflow-x: hidden;
    padding: 0 var(--space-md);
  }

  .carousel-card {
    flex: 0 0 320px;
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-rule);
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .carousel-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(10, 37, 64, 0.08);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    padding: var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h3 {
    font-size: 1.2rem;
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.3;
    transition: color 0.2s;
  }

  .carousel-card:hover h3 {
    color: var(--color-accent);
  }

  .card-content p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-bottom: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .carousel-card {
      flex: 0 0 280px;
    }
  }
</style>
