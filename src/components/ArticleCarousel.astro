---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title: string;
}

const { posts, title } = Astro.props;

const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    '/images/photos/g-01.jpg',
    '/images/photos/g-02.jpg',
    '/images/photos/g-03.jpg',
    '/images/photos/g-04.jpg',
    '/images/photos/g-05.jpg',
    '/images/photos/g-06.jpg',
    '/images/photos/g-07.jpg',
  ],
  'Strategien': [
    '/images/photos/s-01.jpg',
    '/images/photos/s-02.jpg',
    '/images/photos/s-03.jpg',
    '/images/photos/s-04.jpg',
    '/images/photos/s-05.jpg',
    '/images/photos/s-06.jpg',
    '/images/photos/s-07.jpg',
  ],
  'Broker': [
    '/images/photos/b-01.jpg',
    '/images/photos/b-02.jpg',
    '/images/photos/b-03.jpg',
    '/images/photos/b-04.jpg',
    '/images/photos/b-05.jpg',
  ],
  'Steuern': [
    '/images/photos/t-01.jpg',
    '/images/photos/t-02.jpg',
    '/images/photos/t-03.jpg',
    '/images/photos/t-04.jpg',
    '/images/photos/t-05.jpg',
    '/images/photos/t-06.jpg',
    '/images/photos/t-07.jpg',
    '/images/photos/t-08.jpg',
    '/images/photos/t-09.jpg',
    '/images/photos/t-10.jpg',
    '/images/photos/t-11.jpg',
    '/images/photos/t-12.jpg',
    '/images/photos/t-13.jpg',
  ],
};

const variations = [
  '',
  'brightness(0.95) contrast(1.05)',
  'brightness(1.05) contrast(0.95)',
  'brightness(0.92) contrast(1.1) saturate(1.05)',
  'brightness(1.02) saturate(0.9)',
  'brightness(0.98) contrast(1.08)',
];

const allPosts = await getCollection('blog');

const positionMap: Record<string, number> = {};
['Grundlagen', 'Strategien', 'Broker', 'Steuern'].forEach(cat => {
  const sorted = allPosts
    .filter(p => p.data.category === cat)
    .map(p => p.slug)
    .sort();
  sorted.forEach((slug, i) => {
    positionMap[slug] = i;
  });
});

function getImageForPost(post: CollectionEntry<'blog'>): { src: string; filter: string } {
  const images = categoryImages[post.data.category] || categoryImages['Grundlagen'];
  const position = positionMap[post.slug] ?? 0;
  const src = images[position % images.length];
  const filter = variations[position % variations.length];
  return { src, filter };
}

const loopPosts = [...posts, ...posts];
---

<section class="carousel-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{title}</h2>
      <span class="section-rule"></span>
    </div>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-track" id="auto-carousel-track">
      {loopPosts.map((post) => {
        const image = getImageForPost(post);
        return (
        <a href={`/blog/${post.slug}`} class="carousel-card">
          <div class="card-image">
            <img
              src={image.src}
              alt={post.data.title}
              loading="lazy"
              style={`filter: ${image.filter};`}
            />
          </div>
          <div class="card-content">
            <span class="category-tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('auto-carousel-track');
  if (track) {
    let paused = false;
    track.addEventListener('mouseenter', () => { paused = true; });
    track.addEventListener('mouseleave', () => { paused = false; });
    function autoScroll() {
      if (!paused && track) {
        track.scrollLeft += 1;
        if (track.scrollLeft >= track.scrollWidth / 2) {
          track.scrollLeft = 0;
        }
      }
      requestAnimationFrame(autoScroll);
    }
    autoScroll();
  }
</script>

<style>
  .carousel-section {
    padding: var(--space-md) 0 var(--space-xl);
    background: var(--color-paper);
    margin: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding: 0 var(--space-md);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    margin: 0;
  }

  .section-rule {
    flex: 1;
    height: 1px;
    background: var(--color-ink);
  }

  .carousel-wrapper {
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: var(--space-md);
    overflow-x: hidden;
    padding: 0 var(--space-md);
  }

  .carousel-card {
    flex: 0 0 320px;
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-rule);
    transition: all 0.2s;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .carousel-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(10, 37, 64, 0.08);
  }

  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .card-content {
    padding: var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content h3 {
    font-size: 1.2rem;
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1.3;
    transition: color 0.2s;
  }

  .carousel-card:hover h3 {
    color: var(--color-accent);
  }

  .card-content p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    margin-bottom: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .carousel-card {
      flex: 0 0 280px;
    }
  }
</style>
