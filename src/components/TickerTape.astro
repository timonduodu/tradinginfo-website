---
// TradingView Ticker Tape - live Kurs-Lauftext
// Zeigt einen scrollenden Kurs-Ticker mit den wichtigsten Indizes, Forex und Krypto
---

<div class="ticker-wrapper">
  <div class="tradingview-widget-container">
    <div class="tradingview-widget-container__widget"></div>
  </div>
</div>

<script type="text/javascript" is:inline async src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js">
{
  "symbols": [
    { "description": "SMI", "proName": "SIX:SMI" },
    { "description": "S&P 500", "proName": "FOREXCOM:SPXUSD" },
    { "description": "Nasdaq 100", "proName": "FOREXCOM:NSXUSD" },
    { "description": "DAX", "proName": "FOREXCOM:DEUIDXEUR" },
    { "description": "EUR/CHF", "proName": "FX:EURCHF" },
    { "description": "USD/CHF", "proName": "FX:USDCHF" },
    { "description": "EUR/USD", "proName": "FX:EURUSD" },
    { "description": "Gold", "proName": "OANDA:XAUUSD" },
    { "description": "Bitcoin", "proName": "BITSTAMP:BTCUSD" },
    { "description": "Ethereum", "proName": "BITSTAMP:ETHUSD" }
  ],
  "showSymbolLogo": true,
  "isTransparent": false,
  "displayMode": "adaptive",
  "colorTheme": "light",
  "locale": "de_CH"
}
</script>

<style>
  .ticker-wrapper {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    overflow: hidden;
  }

  .tradingview-widget-container {
    height: 46px;
  }
</style>
