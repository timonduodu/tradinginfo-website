---
// TradingView Ticker Tape - live Kurs-Lauftext
---

<div class="ticker-wrapper">
  <div class="tradingview-widget-container">
    <div class="tradingview-widget-container__widget"></div>
  </div>
</div>

<script type="text/javascript" is:inline async src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js">
{
  "symbols": [
    { "description": "SMI", "proName": "SIX:SMI" },
    { "description": "S&P 500", "proName": "FOREXCOM:SPXUSD" },
    { "description": "Nasdaq 100", "proName": "FOREXCOM:NSXUSD" },
    { "description": "DAX", "proName": "XETR:DAX" },
    { "description": "EUR/CHF", "proName": "FX:EURCHF" },
    { "description": "USD/CHF", "proName": "FX:USDCHF" },
    { "description": "EUR/USD", "proName": "FX:EURUSD" },
    { "description": "Gold", "proName": "OANDA:XAUUSD" },
    { "description": "Bitcoin", "proName": "BITSTAMP:BTCUSD" },
    { "description": "Ethereum", "proName": "BITSTAMP:ETHUSD" }
  ],
  "showSymbolLogo": true,
  "isTransparent": false,
  "displayMode": "adaptive",
  "colorTheme": "light",
  "locale": "de_CH"
}
</script>

<style is:global>
  .ticker-wrapper {
    background: #ffffff;
    height: 46px;
    max-height: 46px;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block;
    position: relative;
  }

  .ticker-wrapper > div,
  .ticker-wrapper .tradingview-widget-container,
  .ticker-wrapper .tradingview-widget-container__widget {
    height: 46px !important;
    max-height: 46px !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .ticker-wrapper iframe {
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    vertical-align: top !important;
    height: 46px !important;
  }

  .ticker-wrapper .tradingview-widget-copyright {
    display: none !important;
  }
</style>
