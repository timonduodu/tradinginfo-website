---
// Natives Newsletter-Formular: E-Mail wird hier erfasst und an die
// Beehiiv-Anmeldeseite übergeben (Prefill), statt nur zu verlinken.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['newsletter-signup', { compact }]} data-pagefind-ignore>
  {!compact && (
    <>
      <p class="ns-eyebrow">Newsletter</p>
      <h3 class="ns-title">Der wöchentliche Marktbrief</h3>
      <p class="ns-text">
        Jeden Sonntag: Wochenrückblick, ein Fachartikel und eine kompakte
        Trading-Lektion. Kostenlos, kein Spam.
      </p>
    </>
  )}
  <form class="ns-form" action="https://tradinginfo.beehiiv.com/subscribe" method="get" target="_blank" data-track="newsletter">
    <label class="sr-only" for={`ns-email-${compact ? 'c' : 'f'}`}>E-Mail-Adresse</label>
    <input
      type="email"
      id={`ns-email-${compact ? 'c' : 'f'}`}
      name="email"
      placeholder="deine@email.ch"
      required
      autocomplete="email"
    />
    <button type="submit" class="btn btn-primary">Abonnieren</button>
  </form>
  <p class="ns-fine">
    Mit der Anmeldung akzeptierst du die <a href="/datenschutz">Datenschutzerklärung</a>.
    Abmeldung jederzeit möglich.
  </p>
</div>

<style>
  .newsletter-signup {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    border-top: 3px solid var(--color-accent);
    padding: var(--space-lg);
    text-align: center;
  }

  .newsletter-signup.compact {
    padding: var(--space-md);
  }

  .ns-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-xs);
  }

  .ns-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-xs);
  }

  .ns-text {
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-md);
    line-height: 1.5;
  }

  .ns-form {
    display: flex;
    gap: var(--space-xs);
    max-width: 420px;
    margin: 0 auto var(--space-sm);
  }

  .ns-form input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .ns-form input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .ns-fine {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 480px) {
    .ns-form { flex-direction: column; }
  }
</style>
