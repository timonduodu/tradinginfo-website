---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Start' },
  { href: '/grundlagen', label: 'Grundlagen' },
  { href: '/broker', label: 'Broker' },
  { href: '/strategien', label: 'Strategien' },
  { href: '/steuern', label: 'Steuern' },
  { href: '/about', label: 'Über' },
];
---

<header class="site-header">
  <!-- DESKTOP HEADER -->
  <div class="desktop-header">
    <div class="header-top">
      <div class="container header-top-inner">
        <span class="date" id="current-date"></span>
        <span class="tagline">Unabhängige Trading-Information aus der Schweiz</span>
        <a href="/newsletter" class="newsletter-link">Newsletter →</a>
      </div>
    </div>

    <div class="container header-main">
      <a href="/" class="logo">
        <span class="logo-mark">CH</span>
        <span class="logo-text">TradingInfo</span>
      </a>
    </div>

    <nav class="site-nav">
      <div class="container nav-inner">
        <ul class="nav-list">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { active: currentPath === item.href }]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <!-- MOBILE HEADER -->
  <div class="mobile-header">
    <div class="mobile-bar">
      <a href="/" class="mobile-logo">
        <span class="logo-mark">CH</span>
        <span class="logo-text-mobile">TradingInfo</span>
      </a>
      <button class="hamburger" id="mobile-toggle" aria-label="Menü öffnen" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav class="mobile-nav" id="mobile-nav">
      <ul>
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class:list={['mobile-nav-link', { active: currentPath === item.href }]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li><a href="/newsletter" class="mobile-nav-link mobile-nav-cta">Newsletter abonnieren →</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const dateEl = document.getElementById('current-date');
  if (dateEl) {
    const d = new Date();
    const options: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
    dateEl.textContent = d.toLocaleDateString('de-CH', options);
  }

  const toggle = document.getElementById('mobile-toggle');
  const nav = document.getElementById('mobile-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
    margin: 0;
    padding: 0;
  }

  /* === DEFAULT: Desktop sichtbar, Mobile versteckt === */
  .desktop-header { display: block; }
  .mobile-header { display: none; }

  /* === DESKTOP === */
  .header-top {
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }

  .header-top-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem var(--space-md);
    letter-spacing: 0.05em;
  }

  .date { text-transform: capitalize; }
  .tagline { font-style: italic; opacity: 0.85; }

  .newsletter-link {
    color: var(--color-bg);
    text-decoration: none;
    font-weight: 600;
  }

  .header-main {
    text-align: center;
    padding: var(--space-lg) var(--space-md);
    border-bottom: 3px double var(--color-rule);
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .logo-mark {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: 1.75rem;
    background: var(--color-accent);
    color: var(--color-paper);
    padding: 0.1em 0.4em;
    letter-spacing: -0.02em;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .site-nav { background: var(--color-paper); }

  .nav-inner {
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* === MOBILE === */
  .mobile-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    background: var(--color-paper);
  }

  .mobile-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  .logo-text-mobile {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 22px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .hamburger span {
    display: block;
    height: 2.5px;
    width: 100%;
    background: var(--color-ink);
    border-radius: 2px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .hamburger.open span:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }

  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule);
  }

  .mobile-nav.open { max-height: 500px; }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav li {
    border-bottom: 1px solid var(--color-rule);
  }

  .mobile-nav li:last-child { border-bottom: none; }

  .mobile-nav-link {
    display: block;
    padding: 1rem 1.25rem;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .mobile-nav-link.active {
    color: var(--color-accent);
    background: rgba(185, 28, 28, 0.04);
  }

  .mobile-nav-cta {
    background: var(--color-ink);
    color: var(--color-bg);
    text-align: center;
  }

  /* === BREAKPOINT: Unter 768px wird Mobile gezeigt === */
  @media (max-width: 768px) {
    .desktop-header { display: none; }
    .mobile-header { display: block; }
  }
</style>
