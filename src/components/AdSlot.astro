---
// AdSlot — Werbeplätze
// Bei sponsor.aktiv = true (src/data/sponsor.ts): echte Sponsor-Anzeige mit Link.
// Sonst: Mock-Platzhalter mit Hover-Overlay "Hier könnte Ihre Werbung stehen".
import { sponsor } from '../data/sponsor';

interface Props {
  type?: 'banner' | 'inline' | 'sidebar';
  slot?: 'top' | 'middle' | 'bottom' | 'sidebar';
}

const { type = 'banner', slot = 'top' } = Astro.props;

// Mock-Anzeigen die rotieren basierend auf Slot
const mockAds = {
  top: {
    sponsor: "FINANZ-PARTNER",
    headline: "Trading-Konditionen für Schweizer",
    subline: "Niedrige Gebühren · Schweizer Lizenz · CHF-Konto",
    cta: "Vergleich →",
    badge: "ANZEIGE",
    bgColor: "#0a2540",
    accentColor: "#d4af37",
  },
  middle: {
    sponsor: "VERMÖGENSAUFBAU",
    headline: "ETF-Sparpläne ab CHF 0",
    subline: "Diversifiziert anlegen · Vom ersten Franken an",
    cta: "Mehr erfahren →",
    badge: "WERBUNG",
    bgColor: "#1a3a5c",
    accentColor: "#ffffff",
  },
  bottom: {
    sponsor: "PROFESSIONELL HANDELN",
    headline: "Trading-Plattform für Profis",
    subline: "Optionen · Futures · Forex · CFDs",
    cta: "Konto eröffnen →",
    badge: "SPONSORED",
    bgColor: "#1b7a3e",
    accentColor: "#ffffff",
  },
  sidebar: {
    sponsor: "SCHWEIZER ANBIETER",
    headline: "Steuerauszug inklusive",
    subline: "Direkt für die CH-Steuererklärung",
    cta: "Jetzt informieren →",
    badge: "ANZEIGE",
    bgColor: "#5c1a1a",
    accentColor: "#ffffff",
  },
};

// Aktiver Sponsor überschreibt die Mock-Anzeigen
const istSponsor = sponsor.aktiv && sponsor.url;
const ad = istSponsor
  ? { ...sponsor.ads[slot], badge: 'ANZEIGE' }
  : mockAds[slot];
const href = istSponsor ? sponsor.url : '/werbung';
---

<a
  href={href}
  class:list={[`ad-placeholder ad-placeholder--${type}`, { 'is-sponsor': istSponsor }]}
  aria-label={istSponsor ? `Anzeige: ${sponsor.name}` : 'Werbeplatz - Klicken für Werbeschaltungen'}
  target={istSponsor ? '_blank' : undefined}
  rel={istSponsor ? 'noopener sponsored' : undefined}
  data-sponsor={istSponsor ? sponsor.name : undefined}
>
  {istSponsor ? (
    <div class="ad-real" style={`--ad-bg: ${ad.bgColor}; --ad-accent: ${ad.accentColor};`}>
      {/* Dekorative Chart-Linie im Hintergrund */}
      <svg class="ad-real-spark" viewBox="0 0 300 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 70 L40 58 L75 64 L115 42 L150 50 L195 24 L235 32 L300 4" fill="none" stroke="var(--ad-accent)" stroke-width="2" />
        <path d="M0 70 L40 58 L75 64 L115 42 L150 50 L195 24 L235 32 L300 4 L300 80 L0 80 Z" fill="var(--ad-accent)" opacity="0.12" stroke="none" />
      </svg>
      <div class="ad-badge">{ad.badge}</div>
      <div class="ad-real-main">
        <div class="ad-real-brand">
          <span class="ad-real-logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 17 9 11 13 15 21 7" />
              <polyline points="15 7 21 7 21 13" />
            </svg>
          </span>
          <span class="ad-real-name">{sponsor.name.toUpperCase()}<em>FUNDING</em></span>
        </div>
        <div class="ad-real-headline">{ad.headline}</div>
        <div class="ad-real-subline">{ad.subline}</div>
        {'chips' in ad && ad.chips && (
          <div class="ad-real-chips">
            {ad.chips.map((chip: string) => <span>{chip}</span>)}
          </div>
        )}
      </div>
      <span class="ad-real-btn">
        {ad.cta}
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
        </svg>
      </span>
    </div>
  ) : (
    <div class="ad-mock" style={`background: ${ad.bgColor}; color: ${ad.accentColor};`}>
      <div class="ad-badge">{ad.badge}</div>
      <div class="ad-content">
        <div class="ad-sponsor">{ad.sponsor}</div>
        <div class="ad-headline">{ad.headline}</div>
        <div class="ad-subline">{ad.subline}</div>
        <div class="ad-cta">{ad.cta}</div>
      </div>
    </div>
  )}
  {!istSponsor && (
    <div class="ad-overlay">
      <div class="ad-overlay-content">
        <strong>Hier könnte Ihre Werbung stehen</strong>
        <span>Werbung schalten →</span>
      </div>
    </div>
  )}
</a>

<style>
  .ad-placeholder {
    display: block;
    position: relative;
    margin: var(--space-lg) 0;
    overflow: hidden;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
    isolation: isolate;
  }

  .ad-placeholder--banner { min-height: 120px; }
  .ad-placeholder--inline { min-height: 100px; }
  .ad-placeholder--sidebar { min-height: 250px; }

  .ad-mock {
    width: 100%;
    height: 100%;
    min-height: inherit;
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    position: relative;
    transition: filter 0.25s;
  }

  .ad-placeholder--sidebar .ad-mock {
    flex-direction: column;
    text-align: center;
    justify-content: center;
  }

  .ad-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: rgba(255, 255, 255, 0.15);
    color: inherit;
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    opacity: 0.7;
  }

  .ad-content {
    flex: 1;
  }

  .ad-sponsor {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .ad-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .ad-subline {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    opacity: 0.9;
    margin-bottom: 0.75rem;
  }

  .ad-cta {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Overlay erscheint beim Hover */
  .ad-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
    z-index: 2;
  }

  .ad-placeholder:hover .ad-overlay {
    opacity: 1;
  }

  .ad-placeholder:not(.is-sponsor):hover .ad-mock {
    filter: blur(2px);
  }

  /* ============================================================
     Echte Sponsor-Anzeige (Prop Firm des Betreibers, Name aus sponsor.ts)
     — bewusst als Werbebanner
     gestaltet: Marken-Farben, Sans-Serif, Button-CTA, Logo.
     ============================================================ */
  .ad-real {
    width: 100%;
    height: 100%;
    min-height: inherit;
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    position: relative;
    font-family: var(--font-sans);
    color: #ffffff;
    background:
      radial-gradient(ellipse 60% 120% at 85% 0%, color-mix(in srgb, var(--ad-accent) 30%, transparent), transparent),
      linear-gradient(135deg, var(--ad-bg) 0%, color-mix(in srgb, var(--ad-bg) 82%, var(--ad-accent)) 100%);
  }

  .ad-real-spark {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 70%;
    opacity: 0.35;
    pointer-events: none;
  }

  .ad-real .ad-badge {
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    opacity: 1;
  }

  .ad-real-main {
    flex: 1;
    position: relative;
  }

  .ad-real-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .ad-real-logo {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: grid;
    place-items: center;
    color: #ffffff;
    background: linear-gradient(135deg, var(--ad-accent), color-mix(in srgb, var(--ad-accent) 70%, black));
    box-shadow: 0 0 14px color-mix(in srgb, var(--ad-accent) 50%, transparent);
  }

  .ad-real-name {
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.07em;
  }

  .ad-real-name em {
    font-style: normal;
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--ad-accent);
    filter: brightness(1.4);
    margin-left: 0.45rem;
    vertical-align: 0.12em;
  }

  .ad-real-headline {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .ad-real-subline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .ad-real-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem;
  }

  .ad-real-chips span {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--ad-accent) 55%, transparent);
    background: color-mix(in srgb, var(--ad-accent) 14%, transparent);
    color: #dff5ec;
    white-space: nowrap;
  }

  .ad-real-btn {
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, var(--ad-accent), color-mix(in srgb, var(--ad-accent) 72%, black));
    box-shadow: 0 4px 18px color-mix(in srgb, var(--ad-accent) 45%, transparent);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  /* Sidebar: vertikal gestapelt und zentriert */
  .ad-placeholder--sidebar .ad-real {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  .ad-placeholder--sidebar .ad-real-brand,
  .ad-placeholder--sidebar .ad-real-chips {
    justify-content: center;
  }

  /* Echte Sponsor-Anzeige: dezenter Hover statt Blur */
  .ad-placeholder.is-sponsor:hover .ad-real {
    filter: brightness(1.08);
  }

  .ad-placeholder.is-sponsor:hover .ad-real-btn {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--ad-accent) 60%, transparent);
  }

  .ad-overlay-content {
    text-align: center;
    font-family: var(--font-sans);
  }

  .ad-overlay-content strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .ad-overlay-content span {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    border: 1px solid white;
    display: inline-block;
    margin-top: 0.5rem;
  }

  @media (max-width: 640px) {
    .ad-mock,
    .ad-real {
      padding: var(--space-md);
      flex-direction: column;
      text-align: center;
      gap: var(--space-sm);
    }

    .ad-real-brand,
    .ad-real-chips {
      justify-content: center;
    }

    .ad-real {
      padding-top: var(--space-lg); /* Platz für das ANZEIGE-Badge */
    }

    .ad-overlay-content strong {
      font-size: 1.1rem;
    }
  }
</style>
