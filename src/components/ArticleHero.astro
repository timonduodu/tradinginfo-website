---
// Article Hero Image - kuratierte themenpassende Bilder via Unsplash
// Mit verifizierten Photo-IDs (Stand: Mai 2026)

interface Props {
  slug: string;
  category: string;
  alt?: string;
}

const { slug, category, alt = "Trading Illustration" } = Astro.props;

// Verifizierte Unsplash-Photo-IDs (mehrfach getestet, alle funktionieren)
// Format: photo-XXXXXXXXXX-YYYYYYYYYY
const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    'photo-1611974789855-9c2a0a7236a3',  // Stock screen mit Charts
    'photo-1590283603385-17ffb3a7f29f',  // Trading Terminal
    'photo-1543286386-2e659306cd6c',     // Bloomberg Terminal Look
  ],
  'Strategien': [
    'photo-1642543492481-44e81e3914a7',  // Trading Chart Detail
    'photo-1640340434855-6084b1f4901c',  // Multi-Monitor Trading
    'photo-1611974789855-9c2a0a7236a3',  // Charts Übersicht
  ],
  'Broker': [
    'photo-1604594849809-dfedbc827105',  // Modernes Bürogebäude
    'photo-1450101499163-c8848c66ca85',  // Finanzbezirk
    'photo-1495216875107-c6c043eb703f',  // Bank Schweiz
  ],
  'Steuern': [
    'photo-1554224155-6726b3ff858f',     // Steuerdokumente
    'photo-1554224154-26032cfc77ff',     // Kalkulator + Papier
    'photo-1518568814500-bf0f8d125f46',  // Schweizer Landschaft
  ],
};

// Wähle deterministisch ein Bild basierend auf dem Slug
const images = categoryImages[category] || categoryImages['Grundlagen'];
const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const imageId = images[hash % images.length];

const imageUrl = `https://images.unsplash.com/${imageId}?w=1200&h=600&fit=crop&q=80&auto=format`;
---

<figure class="article-hero">
  <img
    src={imageUrl}
    alt={alt}
    loading="lazy"
    onerror="this.style.display='none'; this.parentElement.style.display='none';"
  />
</figure>

<style>
  .article-hero {
    margin: 0 0 var(--space-lg);
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
