---
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
  category: string;
  alt?: string;
}

const { slug, category, alt = "Trading Illustration" } = Astro.props;

const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    '/images/g-01.svg',
    '/images/g-02.svg',
    '/images/g-03.svg',
    '/images/g-04.svg',
    '/images/g-05.svg',
  ],
  'Strategien': [
    '/images/s-01.svg',
    '/images/s-02.svg',
    '/images/s-03.svg',
    '/images/s-04.svg',
    '/images/s-05.svg',
  ],
  'Broker': [
    '/images/b-01.svg',
    '/images/b-02.svg',
    '/images/b-03.svg',
    '/images/b-04.svg',
  ],
  'Steuern': [
    '/images/t-01.svg',
    '/images/t-02.svg',
    '/images/t-03.svg',
    '/images/t-04.svg',
  ],
};

const variations = [
  'hue-rotate(0deg) saturate(1)',
  'hue-rotate(30deg) saturate(1.1) brightness(1.05)',
  'hue-rotate(60deg) saturate(0.9)',
  'hue-rotate(90deg) saturate(1.2) brightness(0.95)',
  'hue-rotate(120deg) saturate(1)',
  'hue-rotate(150deg) saturate(1.1) brightness(1.05)',
  'hue-rotate(180deg) saturate(0.95)',
  'hue-rotate(210deg) saturate(1.15) brightness(0.95)',
  'hue-rotate(240deg) saturate(1)',
  'hue-rotate(270deg) saturate(1.1) brightness(1.05)',
  'hue-rotate(300deg) saturate(0.9)',
  'hue-rotate(330deg) saturate(1.2) brightness(0.95)',
  'hue-rotate(15deg) saturate(0.85) brightness(1.1)',
  'hue-rotate(45deg) saturate(1.25) brightness(0.9)',
  'hue-rotate(75deg) saturate(0.95) brightness(1.05)',
  'hue-rotate(105deg) saturate(1.15) brightness(0.95)',
  'hue-rotate(135deg) saturate(1.05) brightness(1.05)',
  'hue-rotate(165deg) saturate(0.9) brightness(0.95)',
  'hue-rotate(195deg) saturate(1.2) brightness(1.05)',
  'hue-rotate(225deg) saturate(1.05) brightness(0.95)',
  'hue-rotate(255deg) saturate(0.95) brightness(1.1)',
  'hue-rotate(285deg) saturate(1.15) brightness(0.9)',
  'hue-rotate(315deg) saturate(1.1) brightness(1.05)',
  'hue-rotate(345deg) saturate(0.85) brightness(0.95)',
];

const allPosts = await getCollection('blog');
const sameCategory = allPosts
  .filter(p => p.data.category === category)
  .map(p => p.slug)
  .sort();

const position = sameCategory.indexOf(slug);

const images = categoryImages[category] || categoryImages['Grundlagen'];
const imageUrl = images[position % images.length];
const filterValue = variations[position % variations.length];
---

<figure class="article-hero">
  <img src={imageUrl} alt={alt} loading="lazy" style={`filter: ${filterValue};`} />
</figure>

<style>
  .article-hero {
    margin: 0 0 var(--space-lg);
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.3s ease;
  }
</style>
