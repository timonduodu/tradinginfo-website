---
// Article Hero Image - kuratierte themenpassende Bilder via Unsplash
// Wir nutzen feste Unsplash-Photo-IDs (kein API-Call, direkter Image-URL)

interface Props {
  slug: string;
  category: string;
  alt?: string;
}

const { slug, category, alt = "Trading Illustration" } = Astro.props;

// Kuratierte Unsplash-Photo-IDs pro Kategorie
// Diese sind getestete URLs die definitiv passende Bilder liefern
const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    'photo-1611974789855-9c2a0a7236a3',  // Charts/Analysis
    'photo-1590283603385-17ffb3a7f29f',  // Stock screen
    'photo-1554260570-9140fd3b7614',     // Trading desk
    'photo-1635236066449-5077fffbe50f',  // Calculator/numbers
    'photo-1518186285589-2f7649de83e0',  // Calculator close-up
  ],
  'Strategien': [
    'photo-1642543492481-44e81e3914a7',  // Trading chart
    'photo-1611974789855-9c2a0a7236a3',  // Multi-screen
    'photo-1551836022-d5d88e9218df',     // Stock chart
    'photo-1543286386-2e659306cd6c',     // Market data
    'photo-1591696205602-2f950c417cb9',  // Trader at work
  ],
  'Broker': [
    'photo-1604594849809-dfedbc827105',  // Modern building
    'photo-1551836022-d5d88e9218df',     // Business district
    'photo-1450101499163-c8848c66ca85',  // Banking
    'photo-1495216875107-c6c043eb703f',  // Bank Switzerland
    'photo-1577962917302-cd874c4e31d2',  // Skyscrapers
  ],
  'Steuern': [
    'photo-1554224155-6726b3ff858f',     // Documents
    'photo-1450101499163-c8848c66ca85',  // Calculator + papers
    'photo-1554224154-26032cfc77ff',     // Tax documents
    'photo-1554224154-22dec7ec8818',     // Paper work
    'photo-1518568814500-bf0f8d125f46',  // Switzerland landscape
  ],
};

// Wähle deterministisch ein Bild basierend auf dem Slug
const images = categoryImages[category] || categoryImages['Grundlagen'];
const hash = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const imageId = images[hash % images.length];

const imageUrl = `https://images.unsplash.com/${imageId}?w=1200&h=600&fit=crop&q=80`;
---

<figure class="article-hero">
  <img src={imageUrl} alt={alt} loading="lazy" />
</figure>

<style>
  .article-hero {
    margin: 0 0 var(--space-lg);
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
