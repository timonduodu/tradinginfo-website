---
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
  category: string;
  alt?: string;
}

const { slug, category, alt = "Trading Illustration" } = Astro.props;

// Echte Foto-Bilder pro Kategorie (in /public/images/photos/)
const categoryImages: Record<string, string[]> = {
  'Grundlagen': [
    '/images/photos/g-01.jpg',
    '/images/photos/g-02.jpg',
    '/images/photos/g-03.jpg',
    '/images/photos/g-04.jpg',
    '/images/photos/g-05.jpg',
    '/images/photos/g-06.jpg',
    '/images/photos/g-07.jpg',
  ],
  'Strategien': [
    '/images/photos/s-01.jpg',
    '/images/photos/s-02.jpg',
    '/images/photos/s-03.jpg',
    '/images/photos/s-04.jpg',
    '/images/photos/s-05.jpg',
    '/images/photos/s-06.jpg',
    '/images/photos/s-07.jpg',
  ],
  'Broker': [
    '/images/photos/b-01.jpg',
    '/images/photos/b-02.jpg',
    '/images/photos/b-03.jpg',
    '/images/photos/b-04.jpg',
    '/images/photos/b-05.jpg',
  ],
  'Steuern': [
    '/images/photos/t-01.jpg',
    '/images/photos/t-02.jpg',
    '/images/photos/t-03.jpg',
    '/images/photos/t-04.jpg',
    '/images/photos/t-05.jpg',
    '/images/photos/t-06.jpg',
    '/images/photos/t-07.jpg',
    '/images/photos/t-08.jpg',
    '/images/photos/t-09.jpg',
    '/images/photos/t-10.jpg',
    '/images/photos/t-11.jpg',
    '/images/photos/t-12.jpg',
    '/images/photos/t-13.jpg',
  ],
  'Krypto': [
    '/images/photos/k-01.jpg',
    '/images/photos/k-02.jpg',
    '/images/photos/k-03.jpg',
    '/images/photos/k-04.jpg',
    '/images/photos/k-05.jpg',
    '/images/photos/k-06.jpg',
    '/images/photos/k-07.jpg',
  ],
};

// Bei Fotos KEINE Hue-Rotation (das verzerrt Hauttöne und natürliche Farben)
// Stattdessen: leichte Brightness/Contrast Variationen
const variations = [
  '',
  'brightness(0.95) contrast(1.05)',
  'brightness(1.05) contrast(0.95)',
  'brightness(0.92) contrast(1.1) saturate(1.05)',
  'brightness(1.02) saturate(0.9)',
  'brightness(0.98) contrast(1.08)',
];

const allPosts = await getCollection('blog');
const sameCategory = allPosts
  .filter(p => p.data.category === category)
  .map(p => p.slug)
  .sort();

const position = sameCategory.indexOf(slug);

const images = categoryImages[category] || categoryImages['Grundlagen'];
const imageUrl = images[position % images.length];
const filterValue = variations[position % variations.length];
---

<figure class="article-hero">
  <img src={imageUrl} alt={alt} loading="lazy" style={`filter: ${filterValue};`} />
</figure>

<style>
  .article-hero {
    margin: 0 0 var(--space-lg);
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
